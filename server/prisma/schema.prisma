generator client {
  provider      = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Customer {
  customerId Int      @id @default(autoincrement()) @map("customer_id")
  fullName   String   @map("full_name") @db.VarChar(100)
  phone      String   @map("phone") @db.VarChar(15)
  email      String?  @db.VarChar(100)
  address    String?  @db.Text
  city       String?  @db.VarChar(50)
  state      String?  @db.VarChar(50)
  pincode    String?  @db.VarChar(10)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@index([phone])
  @@map("customers")
}

model Product {
  id               Int            @id @default(autoincrement())
  name             String         @db.VarChar(200)
  slug             String         @unique @db.VarChar(200)
  shortDescription String?        @map("short_description") @db.Text
  fullDescription  String?        @map("full_description") @db.Text
  price            Decimal        @db.Decimal(10, 2)
  originalPrice    Decimal        @map("original_price") @db.Decimal(10, 2)
  discountPercentage Int?         @map("discount_percentage")
  sku              String?        @db.VarChar(100)
  stockQuantity    Int            @default(0) @map("stock_quantity")
  category         String?        @db.VarChar(100)
  detailsMaterials  String?        @map("details_materials") @db.Text
  shippingReturns   String?        @map("shipping_returns") @db.Text
  careInstructions  String?        @map("care_instructions") @db.Text
  isActive         Boolean        @default(true) @map("is_active")
  isFeatured       Boolean        @default(false) @map("is_featured")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  images ProductImage[]
  videos ProductVideo[]
  orders Order[]
  items  OrderItem[]

  @@index([isActive])
  @@index([isFeatured])
  @@index([category])
  @@map("products")
}

model ProductImage {
  id           Int      @id @default(autoincrement())
  productId    Int      @map("product_id")
  imageUrl     String   @map("image_url") @db.Text
  altText      String   @default("") @map("alt_text") @db.VarChar(500)
  displayOrder Int      @default(0) @map("display_order")
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductVideo {
  id           Int      @id @default(autoincrement())
  productId    Int      @map("product_id")
  videoUrl     String   @map("video_url") @db.Text
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_videos")
}

model Order {
  orderId      Int      @id @default(autoincrement()) @map("order_id")
  orderNumber  String   @unique @map("order_number") @db.VarChar(30)
  customerId   Int      @map("customer_id")
  productId    Int?     @map("product_id")
  productName  String   @default("Premium Crystal Necklace") @map("product_name") @db.VarChar(200)
  quantity     Int      @default(1)
  unitPrice    Decimal  @map("unit_price") @db.Decimal(10, 2)
  totalAmount  Decimal  @map("total_amount") @db.Decimal(10, 2)
  paymentMethod String  @default("COD") @map("payment_method") @db.VarChar(30)
  status       String   @default("Pending") @db.VarChar(30)
  trackingNumber String? @map("tracking_number") @db.VarChar(100)
  notes        String?  @db.Text
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customer    Customer              @relation(fields: [customerId], references: [customerId], onDelete: Cascade)
  product     Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  statusHistory OrderStatusHistory[]
  items       OrderItem[]

  @@index([orderNumber])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderStatusHistory {
  historyId Int      @id @default(autoincrement()) @map("history_id")
  orderId   Int      @map("order_id")
  oldStatus String?  @map("old_status") @db.VarChar(30)
  newStatus String   @map("new_status") @db.VarChar(30)
  changedBy String   @default("system") @map("changed_by") @db.VarChar(50)
  changedAt DateTime @default(now()) @map("changed_at")
  remarks   String?  @db.Text

  order Order @relation(fields: [orderId], references: [orderId], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int      @map("order_id")
  productId  Int?     @map("product_id")
  productName String  @map("product_name") @db.VarChar(200)
  productImage String? @map("product_image") @db.Text
  quantity   Int      @default(1)
  unitPrice  Decimal  @map("unit_price") @db.Decimal(10, 2)
  totalPrice Decimal  @map("total_price") @db.Decimal(10, 2)

  order   Order    @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

model Admin {
  adminId    Int      @id @default(autoincrement()) @map("admin_id")
  email      String   @unique @db.VarChar(100)
  password   String   @db.VarChar(255)
  name       String   @db.VarChar(100)
  role       String   @default("admin") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("admins")
}

model Setting {
  settingId Int    @id @default(autoincrement()) @map("setting_id")
  key       String @unique @db.VarChar(100)
  value     String @db.Text

  @@map("settings")
}

model HeroContent {
  id           Int     @id @default(autoincrement())
  title        String  @db.Text
  subtitle     String  @db.Text
  buttonText   String  @default("ORDER NOW") @db.VarChar(100)
  badgeText    String  @default("Premium Crystal") @db.VarChar(200)
  price        Decimal @db.Decimal(10, 2)
  discountPrice Decimal @db.Decimal(10, 2)
  isActive     Boolean @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("hero_content")
}

model ProductFeature {
  id          Int     @id @default(autoincrement())
  icon        String  @db.VarChar(50)
  title       String  @db.VarChar(200)
  description String  @db.Text
  section     String  @db.VarChar(50) @default("why_love") // why_love | trust_banner | reassurance
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("product_features")
}

model GalleryImage {
  id          Int     @id @default(autoincrement())
  imageUrl    String  @map("image_url") @db.Text
  caption     String  @db.VarChar(200)
  sectionType String  @default("gallery") @map("section_type") @db.VarChar(50) // gallery | product_detail | whats_included
  sortOrder   Int     @default(0) @map("sort_order")
  spanClass   String? @map("span_class") @db.VarChar(50) // for gallery row-span layout
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("gallery_images")
}

model LuxuryBenefit {
  id          Int     @id @default(autoincrement())
  imageUrl    String  @map("image_url") @db.Text
  title       String  @db.VarChar(200)
  description String  @db.Text
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("luxury_benefits")
}

model CTASection {
  id          Int     @id @default(autoincrement())
  sectionKey  String  @unique @map("section_key") @db.VarChar(50)
  buttonText  String  @default("ORDER NOW") @db.VarChar(100)
  headline    String? @db.Text
  subheadline String? @db.Text
  isVisible   Boolean @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("cta_sections")
}

model MediaLibrary {
  id           Int      @id @default(autoincrement())
  fileName     String   @map("file_name") @db.VarChar(255)
  originalName String   @map("original_name") @db.VarChar(255)
  fileUrl      String   @map("file_url") @db.Text
  fileSize     Int      @map("file_size")
  mimeType     String   @map("mime_type") @db.VarChar(50)
  width        Int?
  height       Int?
  altText      String   @default("") @map("alt_text") @db.VarChar(500)
  sectionName  String   @default("general") @map("section_name") @db.VarChar(50)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  sectionImages SectionImage[]
  heroMedia     HeroMedia[]

  @@index([sectionName])
  @@index([isActive])
  @@map("media_library")
}

model HeroMedia {
  id           Int      @id @default(autoincrement())
  mediaId      Int      @map("media_id")
  mediaType    String   @default("image") @map("media_type") @db.VarChar(20)
  displayOrder Int      @default(0) @map("display_order")
  isPrimary    Boolean  @default(false) @map("is_primary")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  media MediaLibrary @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([isActive])
  @@index([isPrimary])
  @@map("hero_media")
}

model SectionImage {
  id           Int      @id @default(autoincrement())
  sectionKey   String   @map("section_key") @db.VarChar(50)
  mediaId      Int      @map("media_id")
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  media MediaLibrary @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@index([sectionKey])
  @@index([isActive])
  @@map("section_images")
}
